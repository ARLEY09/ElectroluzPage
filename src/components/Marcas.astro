---
interface Props {
    icon: string;
    marca: string;
}
const { icon, marca } = Astro.props;
---

<div class="flex flex-col items-center py-2 space-y-5">
    <img 
    src={icon} 
    alt='Icono de marca' 
    class="w-32 h-32 object-contain rounded-lg shadow-md hover:scale-105 transition-transform duration-300"
    />
    <h3 class="block text-gray-700 font-medium">{marca}</h3>
</div>