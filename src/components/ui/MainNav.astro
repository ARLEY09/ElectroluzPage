---
const navigation = [
    { name: 'Inicio', href: '/' },
    { name: 'Cables', href: '/Cables/Alambres' },
    { name: 'Iluminación', href: '/Iluminacion' },
    { name: 'Switcheria', href: '/Switcheria' },
    { name: 'Tableros / Breakers', href: '/Breakers' },
    { name: 'Consumibles', href: '/Consumibles' },
    { name: 'Tuberia', href: '/Tuberia' },
    { name: 'Herramientas', href: '/Herramientas' },
];
---

<nav class="flex flex-col items-center lg:flex-row gap-3">
    {navigation.map(item => 
        <a href={item.href} class="uppercase text-lg font-bold text-white hover:text-orange-400 hover:scale-105 transition-colors">
            {item.name}
        </a>
    )}
</nav>