---

interface Props {
    ListaProductos: any[];
}
const { ListaProductos } = Astro.props;
---

<section class="flex flex-wrap items-center lg:flex-row gap-5">
    {ListaProductos.map(producto => 
        <div class="min-w-[256px] flex flex-col items-center py-2 space-y-5 mx-auto">
            <img 
                src={producto.imagen} 
                alt='imagen producto' 
                class="w-64 h-64 object-contain rounded-lg shadow-md hover:scale-105 transition-transform duration-300"
            />
            <div>
                <h3 class="block text-gray-700">Nombre: {producto.nombre}</h3>
                <h3 class="block text-gray-700">Codigo: {producto.codigo}</h3>
                <h3 class="block text-gray-700">Marca: {producto.marca}</h3>
                <div class="min-h-10 relative bg-[#128C7E] text-center text-gray-700 mt-3 rounded-lg shadow-lg flex items-center justify-center mx-auto hover:scale-105 hover:bg-[#25D366] transition-transform duration-300">
                    <a href={`https://wa.me/+573174353902?text=Hola, quisiera saber disponibilidad y precio de: *[${producto.codigo}]* ${producto.nombre} || Marca: ${producto.marca}`} target="_blank" style="display:inline-block;  color:#FFF; padding:5px 20px; border-radius:5px; text-align:center; text-decoration:none; font-size:16px;">
                        <div class="flex items-center gap-3 hover:scale-105 transition-transform duration-300">
                            <i class="fa fa-whatsapp"></i> Cotizar Producto
                        </div>
                    </a>
                </div>
            </div>
        </div>
    )}
</section>