---
interface Props {
    ListaProductos: any[];
}
const { ListaProductos } = Astro.props;
---

<section class="flex flex-wrap items-center lg:flex-row gap-5">
    {
        ListaProductos.map((producto) => (
            <div class=" card min-w-[256px] flex flex-col items-center py-2 space-y-5 mx-auto">
                <img
                    src={producto.imagen}
                    alt="imagen producto"
                    class="w-64 h-64 object-contain rounded-lg shadow-md hover:scale-105 transition-transform duration-300"
                />
                <div class="card-2 w-full">
                    <h3 class="block text-gray-700 text-lg font-bold">
                        <span class="nombreP">{producto.nombre}</span>
                    </h3>
                    <h3 class="block text-gray-700">
                        Codigo: <span class="codigoP">{producto.codigo}</span>
                    </h3>
                    <h3 class="block text-gray-700">
                        Marca: <span class="marcaP">{producto.marca}</span>
                    </h3>
                    <div class="min-h-10 relative bg-orange-500 text-white text-center text-gray-700 mt-3 rounded-lg shadow-lg flex items-center justify-center mx-auto hover:scale-105 hover:bg-orange-600 transition-transform duration-300 agregar-carrito">
                        <div class="flex items-center gap-3 hover:scale-105 transition-transform duration-300 agregar-carrito">
                            <i class="fa fa-shopping-cart" /> Agregar al carrito
                        </div>
                    </div>
                </div>
            </div>
        ))
    }
</section>
