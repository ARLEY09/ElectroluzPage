---
import "@/styles/carrito.css";
---

<button id="btnCarrito" class="btn-carrito">🛒</button>

<div id="carritoPopup" class="carrito-popup md:min-w-[500px]">
  <div id="carrito">
    <table id="lista-carrito" class="u-full-width">
      <thead>
        <tr>
          <th>Imagen</th>
          <th>Codigo</th>
          <th>Nombre</th>
          <th>Marca</th>
          <th>Cantidad</th>
          <th></th>
        </tr>
      </thead>
      <tbody class="text-center"></tbody>
    </table>

    <div class="min-h-10 bg-[#128C7E] mt-3 rounded-lg flex items-center justify-center hover:scale-105 hover:bg-[#25D366] transition">
      <a id="btnWhatsApp" href="#" target="_blank" class="text-white py-2 px-5">
        <div class="flex items-center gap-2">
          <i class="fa fa-whatsapp"></i> COTIZAR PRODUCTOS
        </div>
      </a>
    </div>

    <a href="#" id="vaciar-carrito" class="button">Vaciar Carrito</a>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const btn = document.getElementById("btnCarrito");
  const popup = document.getElementById("carritoPopup");

  const carrito = document.querySelector("#carrito");
  const listaProductos = document.querySelector("#listaProductos");
  const contenedorCarrito = document.querySelector("#lista-carrito tbody");
  const vaciarCarritoBtn = document.querySelector("#vaciar-carrito");
  const btnWhatsApp = document.getElementById("btnWhatsApp");

  let articulosCarrito = [];

  // ================= UI =================
  if (btn && popup) {
    btn.addEventListener("click", () => {
      popup.classList.toggle("active");
    });

    document.addEventListener("click", (e) => {
      if (!popup.contains(e.target) && !btn.contains(e.target)) {
        popup.classList.remove("active");
      }
    });
  }

  // ================= EVENTS =================
  if (listaProductos) {
    listaProductos.addEventListener("click", agregarProducto);
  }

  if (carrito) {
    carrito.addEventListener("click", eliminarProducto);
  }

  if (vaciarCarritoBtn) {
    vaciarCarritoBtn.addEventListener("click", vaciarCarrito);
  }

  // ================= LOGICA =================

  function agregarProducto(e) {
    e.preventDefault();

    if (e.target.classList.contains("agregar-carrito")) {
      const producto = e.target.parentElement.parentElement.parentElement;

      const infoProducto = {
        imagen: producto.querySelector("img").src,
        nombre: producto.querySelector(".nombreP").textContent,
        marca: producto.querySelector(".marcaP").textContent,
        codigo: producto.querySelector(".codigoP").textContent,
        cantidad: 1,
      };

      const existe = articulosCarrito.some(p => p.codigo === infoProducto.codigo);

      if (existe) {
        articulosCarrito = articulosCarrito.map(p => {
          if (p.codigo === infoProducto.codigo) {
            p.cantidad++;
          }
          return p;
        });
      } else {
        articulosCarrito.push(infoProducto);
      }

      renderCarrito();
    }
  }

  function eliminarProducto(e) {
    e.preventDefault();

    if (e.target.classList.contains("borrar-producto")) {
      const codigo = e.target.getAttribute("data-id");

      articulosCarrito = articulosCarrito.filter(p => p.codigo !== codigo);

      renderCarrito();
    }
  }

  function renderCarrito() {
    contenedorCarrito.innerHTML = "";

    articulosCarrito.forEach(p => {
      const row = document.createElement("tr");

      row.innerHTML = `
        <td><img src="${p.imagen}" width="80"></td>
        <td>${p.codigo}</td>
        <td>${p.nombre}</td>
        <td>${p.marca}</td>
        <td class="text-center">${p.cantidad}</td>
        <td>
          <a href="#" class="borrar-producto text-red-500 font-bold" data-id="${p.codigo}">X</a>
        </td>
      `;

      contenedorCarrito.appendChild(row);
    });

    actualizarWhatsApp();
  }

  function vaciarCarrito(e) {
    if (e) e.preventDefault();

    articulosCarrito = [];
    contenedorCarrito.innerHTML = "";
    actualizarWhatsApp();
  }

  function actualizarWhatsApp() {
    if (!btnWhatsApp) return;

    if (articulosCarrito.length === 0) {
      btnWhatsApp.href = "#";
      return;
    }

    const mensaje = articulosCarrito
      .map(p => `${p.nombre} (${p.codigo}) x${p.cantidad}`)
      .join(", ");

    btnWhatsApp.href =
      "https://wa.me/573174353902?text=" +
      encodeURIComponent("Hola, quisiera saber disponibilidad y precio de: " + mensaje);
  }

});
</script>