---
import "@/styles/carrito.css";
---

<!-- Botón -->
<button id="btnCarrito" class="btn-carrito"> 🛒 </button>

<!-- Popup -->
<div id="carritoPopup" class="carrito-popup md:min-w-[500px]">
    <div id="carrito">
        <table id="lista-carrito" class="u-full-width">
            <thead>
                <tr>
                    <th class="md:min-w-[100px] mr-100">Imagen</th>
                    <th>Codigo</th>
                    <th class="md:min-w-[150px]">Nombre</th>
                    <th>Marca</th>
                    <th>Cantidad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="text-center center-items"></tbody>
        </table>

        <div
            class="min-h-10 relative bg-[#128C7E] text-center text-gray-700 mt-3 rounded-lg shadow-lg flex items-center justify-center mx-auto hover:scale-105 hover:bg-[#25D366] transition-transform duration-300"
        >
            <a
                href={`https://wa.me/+573174353902?text=Hola, quisiera saber disponibilidad y precio de: ${articulosCarrito.map((Producto) => `${Producto.nombre} (${Producto.codigo}) x${Producto.cantidad}`).join(", ")}`}
                target="_blank"
                style="display:inline-block;  color:#FFF; padding:5px 20px; border-radius:5px; text-align:center; text-decoration:none; font-size:16px;"
            >
                <div
                    class="flex items-center gap-3 hover:scale-105 transition-transform duration-300"
                >
                    <i class="fa fa-whatsapp"></i> COTIZAR PRODUCTOS
                </div>
            </a>
        </div>

        <a href="#" id="vaciar-carrito" class="button"> Vaciar Carrito </a>
    </div>
</div>

<script>
    const btn = document.getElementById("btnCarrito");
    const popup = document.getElementById("carritoPopup");

    if (btn && popup) {
        btn.addEventListener("click", () => {
            popup.classList.toggle("active");
        });

        document.addEventListener("click", (e) => {
            const target = e.target as Node;

            if (!popup.contains(target) && !btn.contains(target)) {
                popup.classList.remove("active");
            }
        });
    }
</script>

<script>
    import { any } from "astro:schema";

    // Variables
    const carrito = document.querySelector("#carrito");
    const listaProductos = document.querySelector("#listaProductos");
    const contenedorCarrito = document.querySelector("#lista-carrito tbody");
    const vaciarCarritoBtn = document.querySelector("#vaciar-carrito");
    let articulosCarrito = [];

    // Listeners
    cargarEventListeners();

    function cargarEventListeners() {
        // Dispara cuando se presiona "Agregar Carrito"
        if (listaProductos) {
            listaProductos.addEventListener("click", agregarProducto);
        }

        // Cuando se elimina un curso del carrito
        if (carrito) {
            carrito.addEventListener("click", eliminarProducto);
        }

        // Al Vaciar el carrito
        if (vaciarCarritoBtn) {
            vaciarCarritoBtn.addEventListener("click", vaciarCarrito);
        }
    }

    // Funciones
    // Función que añade el curso al carrito
    function agregarProducto(e) {
        e.preventDefault();
        // Delegation para agregar-carrito
        if (e.target.classList.contains("agregar-carrito")) {
            const Producto = e.target.parentElement.parentElement.parentElement;
            // Enviamos el curso seleccionado para tomar sus datos
            leerDatosProducto(Producto);
        }
    }

    // Lee los datos del curso
    function leerDatosProducto(Producto) {
        const infoProducto = {
            imagen: Producto.querySelector("img").src,
            nombre: Producto.querySelector(".nombreP").textContent,
            marca: Producto.querySelector(".marcaP").textContent,
            codigo: Producto.querySelector(".codigoP").textContent,
            cantidad: 1,
        };

        if (
            articulosCarrito.some(
                (Producto) => Producto.codigo === infoProducto.codigo,
            )
        ) {
            const Productos = articulosCarrito.map((Producto) => {
                if (Producto.codigo === infoProducto.codigo) {
                    Producto.cantidad++;
                    return Producto;
                } else {
                    return Producto;
                }
            });
            articulosCarrito = [...Productos];
        } else {
            articulosCarrito = [...articulosCarrito, infoProducto];
        }

        // console.log(articulosCarrito)

        // console.log(articulosCarrito)
        carritoHTML();
    }

    // Elimina el curso del carrito en el DOM
    function eliminarProducto(e) {
        console.log("Click en eliminar producto");
        e.preventDefault();
        if (e.target.classList.contains("borrar-producto")) {
            console.log("Clase borrar producto detectada");
            // e.target.parentElement.parentElement.remove();
            const productoCodigo = e.target.getAttribute("data-id");
            console.log("Tratas de eliminar el producto" + productoCodigo);

            // Eliminar del arreglo del carrito
            articulosCarrito = articulosCarrito.filter(
                (Producto) => Producto.codigo !== productoCodigo,
            );

            carritoHTML();
        }
    }

    // Muestra el curso seleccionado en el Carrito
    function carritoHTML() {
        vaciarCarrito();

        articulosCarrito.forEach((Producto) => {
            const row = document.createElement("tr");
            row.innerHTML = `
               <td>  
                    <img src="${Producto.imagen}" width=100>
               </td>
               <td>${Producto.codigo}</td>
               <td>${Producto.nombre}</td>
               <td>${Producto.marca}</td>
               <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                ${Producto.cantidad} </td>
                <td>
                    <a href="#" class="borrar-producto text-lg font-bold text-red-500" data-id="${Producto.codigo}">X</a>
               </td>
          `;
            contenedorCarrito.appendChild(row);
        });
    }

    // Elimina los cursos del carrito en el DOM
    function vaciarCarrito() {
        // forma lenta
        // contenedorCarrito.innerHTML = '';

        // forma rapida (recomendada)
        while (contenedorCarrito.firstChild) {
            contenedorCarrito.removeChild(contenedorCarrito.firstChild);
        }
    }
</script>
