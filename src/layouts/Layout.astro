---
import '@/styles/global.css';
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";

interface Props{
   title: string;
   bgImage: string;
   subtitle: string;
}
const { title, bgImage, subtitle } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Electroluz Valle : {title}</title>
        <link
            rel="icon"
            type="image/svg+xml"
            href="/public/favicon.ico"
        />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css">
	</head>
	<body class="bg-gray-200">

		<a href="https://wa.me/+573174353902?text=Hola" class="float-wa" target="_blank">
    		<i class="fa fa-whatsapp" style="margin-top:16px;"></i>
		</a>

		<Header
			bgImage={bgImage}
			subtitle={subtitle}
		/>
		
		<main class="bg-white p-10 md:p-10 md:pb-20 max-w-7xl mx-auto -mt-20 rounded-lg shadow-lg lg:-mt-20 relative">
			<slot />
		</main>

		<Footer />
	</body>
</html>
